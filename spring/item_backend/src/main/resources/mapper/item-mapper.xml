<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!-- 해당 파일에 모든 쿼리문을 작성 -->
<!-- namespace에는 xml파일과 연결할 Mapper interface 파일명을 패키지를 포함하여 적어주세요 -->
<mapper namespace="com.example.item_backend.itemMapper.ItemMapper">
    <resultMap id="itemMember" type="com.example.item_backend.itemDTO.ItemDTO">
        <id column="ITEM_NUM" property="itemNum"/>
        <result column="ITEM_NAME" property="itemName"/>
        <result column="PRICE" property="price"/>
        <result column="ITEM_REGNAME" property="itemRegName"/>
        <result column="ITEM_INTRO" property="itemIntro"/>
        <result column="ITEM_REGDATE" property="itemRegDate"/>
    </resultMap>
    
    <select id="getItemList" resultMap="itemMember">
        SELECT *
        FROM ITEM_INFO
    </select>

    <select id="getDetail" resultMap="itemMember">
        SELECT *
        FROM ITEM_INFO
        WHERE ITEM_NUM = #{itemNum}
    </select>
    <update id="updateDetail">
        UPDATE  ITEM_INFO
        SET ITEM_NAME = #{itemName}
            ,ITEM_INTRO = #{itemIntro}
            ,ITEM_REGNAME = #{itemRegName}
            ,PRICE = #{price}
        WHERE ITEM_NUM=#{itemNum}
    </update>
    <delete id="deleteDetail">
        DELETE FROM ITEM_INFO
        WHERE ITEM_NUM = #{itemNum}
    </delete>
    <insert id="insertData"> INSERT INTO ITEM_INFO (
        ITEM_NAME,
        PRICE,
        ITEM_REGNAME,
        ITEM_INTRO
    ) VALUES (
                 #{itemName},
                 #{price},
                 #{itemRegName},
                 #{itemIntro}
             )
    </insert>
</mapper>































